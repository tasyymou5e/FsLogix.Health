<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="WndRunAs"
    Title="Relaunch as a Different User (Smart Card)"
    Width="560"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <!-- FSLogixToolkit run-as dialog. No event attributes: handlers are attached by the dashboard code.
         The toolkit never prompts for, reads, passes, logs or stores a password or PIN: Windows (runas.exe)
         asks for the smart card and PIN in its own window. -->
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TxtRunAsCurrent" TextWrapping="Wrap"
                   FontWeight="SemiBold" Margin="0,0,0,10" Text="Running as: -" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="User name:" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtRunAsUser" MaxLength="512" VerticalContentAlignment="Center" Margin="0,0,0,8" />

        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ChkRunAsElevate" Margin="0,0,0,10"
                  Content="Elevate after sign-in (the new session asks for UAC as that user)" />

        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TxtRunAsInfo" TextWrapping="Wrap"
                   Foreground="#FF7D4E00" Margin="0,0,0,8"
                   Text="Windows asks for the smart card and PIN in its own window. The toolkit never sees, stores or logs a PIN or password." />

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TxtRunAsError" Foreground="#FFA40E26"
                   TextWrapping="Wrap" Margin="0,0,0,8" Text="" />

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnRunAsOk" Content="Relaunch" IsDefault="True" Padding="14,3" Margin="0,0,8,0" />
            <Button x:Name="BtnRunAsCancel" Content="Cancel" IsCancel="True" Padding="14,3" />
        </StackPanel>
    </Grid>
</Window>
