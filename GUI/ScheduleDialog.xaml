<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="WndSchedule"
    Title="Schedule Daily Health Check"
    Width="500"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <!-- FSLogixToolkit schedule dialog. No event attributes: handlers are attached by the dashboard code. -->
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Registers a Windows scheduled task that runs the FSLogixToolkit daily health check (Start-FSLogixToolkit.ps1 -Daily) once a day and writes reports under the Daily reports folder." />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Time (HH:mm, 24-hour):" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtScheduleTime" Width="80" HorizontalAlignment="Left" MaxLength="5" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Run as:" VerticalAlignment="Top" Margin="0,2,10,8" />
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
            <RadioButton x:Name="RdoRunAsSystem" GroupName="RunAs" Content="System" Margin="0,0,0,4" />
            <RadioButton x:Name="RdoRunAsCurrentUser" GroupName="RunAs" Content="Current user" />
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TxtScheduleElevation" TextWrapping="Wrap" Foreground="#FF7D4E00" Margin="0,0,0,10"
                   Text="Registering the task to run as System requires an elevated (Run as administrator) PowerShell session." />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Container mode:" VerticalAlignment="Center" Margin="0,0,10,8" />
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CmbScheduleMode" Width="240" HorizontalAlignment="Left" Margin="0,0,0,8">
            <ComboBoxItem x:Name="CmbScheduleModeOdfc" Content="Office Containers only (ODFC)" Tag="ODFC" />
            <ComboBoxItem x:Name="CmbScheduleModeProfiles" Content="Profile Containers only" Tag="Profiles" />
            <ComboBoxItem x:Name="CmbScheduleModeBoth" Content="Both" Tag="Both" />
        </ComboBox>

        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
            <CheckBox x:Name="ChkScheduleOffline" Content="Offline (no online version lookup)" Margin="0,0,0,4" />
            <CheckBox x:Name="ChkScheduleReplace" Content="Replace an existing daily schedule" />
        </StackPanel>

        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TxtScheduleError" Foreground="#FFA40E26" TextWrapping="Wrap" Margin="0,0,0,8" Text="" />

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnScheduleOk" Content="Schedule" IsDefault="True" Padding="14,3" Margin="0,0,8,0" />
            <Button x:Name="BtnScheduleCancel" Content="Cancel" IsCancel="True" Padding="14,3" />
        </StackPanel>
    </Grid>
</Window>
