<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="WndContainerReset"
    Title="Reset Office Container (FIX-ODFC-02)"
    Width="1040"
    Height="760"
    MinWidth="860"
    MinHeight="600"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <!-- FSLogixToolkit Office container reset dialog. No event attributes: handlers are attached by the dashboard code. -->
    <Window.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFDECEA" BorderBrush="#FFA40E26" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <TextBlock x:Name="TxtResetWarning" Foreground="#FF7A0B1C" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="This archives the user's Office container and removes it from the storage location." />
        </Border>

        <TextBlock Grid.Row="1" x:Name="TxtResetInfo" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="Select the Office container to reset." />

        <DataGrid Grid.Row="2" x:Name="GridResetContainers"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF6F8FA"
                  ClipboardCopyMode="IncludeHeader">
            <DataGrid.Columns>
                <DataGridTextColumn Header="User" Width="200" Binding="{Binding UserName}" />
                <DataGridTextColumn Header="SID" Width="230" Binding="{Binding SID}" />
                <DataGridTextColumn Header="Size (GB)" Width="80" Binding="{Binding SizeGB}" />
                <DataGridTextColumn Header="Last write" Width="150" Binding="{Binding LastWriteTime}" />
                <DataGridTextColumn Header="Locked" Width="70" Binding="{Binding IsLocked}" />
                <DataGridTextColumn Header="Account" Width="90" Binding="{Binding AccountStatus}" />
                <DataGridTextColumn Header="File" Width="*" Binding="{Binding FullName}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="TxtResetSelected" TextWrapping="Wrap" Margin="0,8,0,4" Text="No container selected." />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="Archive folder:" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtResetArchivePath" VerticalContentAlignment="Center" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}" Text="Change reference:" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtResetChangeReference" MaxLength="128" VerticalContentAlignment="Center" Margin="0,0,0,6" />

            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="TxtResetTypedPrompt" Style="{StaticResource LabelText}"
                       Text="Type the user name to confirm:" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtResetTypedUser" MaxLength="256" VerticalContentAlignment="Center" Margin="0,0,0,6" />

            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="ChkResetSignedOut" Margin="0,2,0,6"
                      Content="I confirm the user is signed out of every session host." />
        </Grid>

        <TextBlock Grid.Row="5" x:Name="TxtResetError" Foreground="#FFA40E26" TextWrapping="Wrap" Margin="0,4,0,0" Text="" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnResetStart" Content="Archive and reset..." IsEnabled="False" />
            <Button x:Name="BtnResetCancel" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
